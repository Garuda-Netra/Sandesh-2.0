# ==============================================================================
# Sandesh 2.0 - Environment Configuration
# ==============================================================================
# Rename this file to .env and place it in the project root.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django & Security
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database & Cache (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# Local dev falls back to SQLite (backend/db.sqlite3) if DATABASE_URL is unset.
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/sandesh_db

# Local dev falls back to InMemoryChannelLayer if REDIS_URL is unset.
# For production (Upstash Redis or standard Redis):
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://default:token@your-redis-server.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# Cloudinary (Production Media & File Storage)
# ------------------------------------------------------------------------------
# Optional for local development (falls back to local filesystem storage).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# WebRTC & TURN Server (Voice & Video Calls Across Different Networks)
# ------------------------------------------------------------------------------
# Free STUN servers are used by default; provide TURN credentials for NAT traversal:
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ------------------------------------------------------------------------------
# "Vyasa" AI Companion & Gemini API (google-genai)
# ------------------------------------------------------------------------------
CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup key for automatic quota/429 failover:
GEMINI_API_KEY_2=your_backup_gemini_api_key_here
CHATBOT_MODEL=gemini-2.5-flash
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_TOKENS=500
CHATBOT_SYSTEM_PROMPT="You are Vyasa, a helpful, general-purpose assistant. You must answer every question the user asks. Give short and very simple answers by default so they are easy to understand."

# ------------------------------------------------------------------------------
# Spotify Integration (Moments Soundtracks)
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Clerk Authentication (Single Sign-On / Social Login)
# ------------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------------------------
# Email Service (SMTP for Notifications & Account Recovery)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sandesh Messenger <noreply@sandesh.com>
