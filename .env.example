# ==============================================================================
# 🕊️ Sandesh 2.0 - Environment Configuration Guide
# ==============================================================================
# Welcome! Copy or rename this file to `.env` in the project root directory:
#   cp .env.example .env
#
# QUICK START TIP:
# You can run Sandesh 2.0 locally with almost ZERO configuration!
# By default, it will automatically use SQLite for data, local filesystem for
# media uploads, and in-memory Channels for WebSockets. Just start the server!
# Fill in the external service keys below whenever you're ready to test them.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django & Security Settings
# ------------------------------------------------------------------------------
# Generate a fresh secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-sandesh-2-0-local-dev-key-change-in-production-12345

# Set to True for local development, False for production deployment
DEBUG=True

# Comma-separated list of hosts/domains that can serve this application
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Trusted origins for CSRF protection (especially important for HTTPS / cloud hosting)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Django logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Database & Real-Time Caching (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
# Database Connection:
# - Leave as sqlite:///db.sqlite3 for zero-setup local development
# - For production (PostgreSQL / Supabase / Neon / Render Postgres):
#   DATABASE_URL=postgres://user:password@hostname:5432/sandesh_db
DATABASE_URL=sqlite:///db.sqlite3

# Redis Channel Layer for WebSockets & Presence Cache:
# - Leave blank for local development (Django Channels uses InMemoryChannelLayer)
# - For production, use Upstash Redis or a standard Redis instance:
#   REDIS_URL=redis://localhost:6379/0
#   REDIS_URL=rediss://default:token@your-endpoint.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 3. Cloudinary (Cloud Media & File Storage)
# ------------------------------------------------------------------------------
# Optional for local development (falls back to local media/ folder).
# Sign up free at https://cloudinary.com to get your cloud credentials:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. WebRTC Voice & Video Calls (TURN / STUN Relays)
# ------------------------------------------------------------------------------
# Free public Google STUN servers are built-in by default for peer-to-peer calls.
# If callers are behind strict firewalls or mobile NATs, provide TURN server credentials:
# (e.g. from Metered.ca, Twilio, or your own coturn server)
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ------------------------------------------------------------------------------
# 5. "Vyasa" AI Companion & Gemini API
# ------------------------------------------------------------------------------
# Choose your AI provider: 'gemini' or 'local' (offline template fallback)
CHATBOT_PROVIDER=gemini

# Grab your free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional secondary key for automated quota / rate-limit (429) failover
GEMINI_API_KEY_2=your_backup_gemini_api_key_here

# Recommended Gemini model for snappy real-time chat responses:
CHATBOT_MODEL=gemini-2.5-flash
CHATBOT_TEMPERATURE=0.7
CHATBOT_MAX_TOKENS=500
CHATBOT_SYSTEM_PROMPT="You are Vyasa, a wise and friendly personal companion in Sandesh. Give clear, warm, concise, and helpful answers."

# ------------------------------------------------------------------------------
# 6. Spotify Integration (Moments & Stories Soundtracks)
# ------------------------------------------------------------------------------
# Optional: Allows users to search and attach song previews to their 24h moments.
# Create a free app at https://developer.spotify.com/dashboard:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. Clerk Single Sign-On (Social & Passwordless Login)
# ------------------------------------------------------------------------------
# Optional: Enables one-tap Google and social sign-in via Clerk.
# Get free keys at https://clerk.com:
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 8. Email Service (SMTP for Account Recovery & Notifications)
# ------------------------------------------------------------------------------
# If left blank, Django will print outgoing emails directly to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sandesh Messenger <noreply@sandesh.com>
